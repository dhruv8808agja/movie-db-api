# Production Environment Configuration
# Copy this file to .env.production and update with your production values

# =====================================
# Database Configuration
# =====================================
DB_DRIVER=postgres

# PostgreSQL Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_IN_PRODUCTION
DB_NAME=moviedb
DB_SSLMODE=require  # Use 'require' or 'verify-full' in production

# =====================================
# JWT Configuration
# =====================================
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_SECRET_KEY_MINIMUM_32_CHARACTERS

# =====================================
# Redis Configuration
# =====================================
REDIS_ADDR=redis:6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_DB=0

# =====================================
# MinIO / S3 Configuration
# =====================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_THIS_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_THIS_SECRET_KEY_MINIMUM_32_CHARACTERS
MINIO_USE_SSL=true  # Set to true if using HTTPS
MINIO_BUCKET=videos

# =====================================
# Server Configuration
# =====================================
SERVER_PORT=8080
GIN_MODE=release  # Use 'release' in production

# =====================================
# Rate Limiting Configuration
# =====================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# =====================================
# Video Upload Configuration
# =====================================
MAX_VIDEO_SIZE=10737418240  # 10GB
UPLOAD_CHUNK_SIZE=5242880   # 5MB
UPLOAD_TEMP_DIR=/app/tmp/uploads
ALLOWED_VIDEO_FORMATS=mp4,avi,mov,mkv,webm,flv

# =====================================
# Application Configuration
# =====================================
APP_PORT=8080
GITHUB_REPOSITORY=your-username/movie-db-api
VERSION=latest

# =====================================
# Deployment Configuration
# =====================================
DEPLOY_ENV=production

# =====================================
# Monitoring & Logging
# =====================================
LOG_LEVEL=info
LOG_FORMAT=json

# =====================================
# CORS Configuration (Optional)
# =====================================
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# =====================================
# SSL/TLS Configuration (Optional)
# =====================================
SSL_CERT_PATH=/etc/ssl/certs/cert.pem
SSL_KEY_PATH=/etc/ssl/private/key.pem

# =====================================
# Backup Configuration
# =====================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# =====================================
# External Services (Optional)
# =====================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Slack Notifications (Optional)
# SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Sentry Error Tracking (Optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# =====================================
# Security Headers
# =====================================
SECURITY_HEADERS_ENABLED=true
HSTS_MAX_AGE=31536000
CONTENT_SECURITY_POLICY=default-src 'self'

# =====================================
# Database Connection Pool
# =====================================
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=3600  # seconds

# =====================================
# IMPORTANT SECURITY NOTES
# =====================================
# 1. Change ALL default passwords and secrets
# 2. Use strong, randomly generated passwords (minimum 32 characters)
# 3. Enable SSL/TLS for all connections in production
# 4. Store this file securely and never commit it to version control
# 5. Use environment-specific secrets management (AWS Secrets Manager, HashiCorp Vault, etc.)
# 6. Rotate secrets regularly
# 7. Use DB_SSLMODE=verify-full in production with proper certificates
# 8. Enable database backups and test restore procedures
# 9. Set up monitoring and alerting
# 10. Review and update security configurations regularly
